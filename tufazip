#!/usr/bin/env python3
"""Decode tufazip v2; model settings and weight loading live in nn.py."""

import argparse
import hashlib
import importlib.metadata
import os
from pathlib import Path
import platform
import signal
import subprocess
import sys

ROOT = Path(__file__).resolve().parent
DETERMINISTIC_ENV = {
    "CUBLAS_WORKSPACE_CONFIG": ":4096:8",
    "PYTHONHASHSEED": "1111",
    "NCCL_ALGO": "Ring",
    "NCCL_DEBUG": "WARN",
    "TORCH_NCCL_ASYNC_ERROR_HANDLING": "1",
    "OMP_NUM_THREADS": "1",
}
PAYLOAD_SHA256 = "198451a21f64386b487b8ea97e141562db355eec9cc9af34e7bbb6a022bcce77"
VOCAB_SHA256 = "a63e517783e84a778f3f08c1f2321f3e2035e64d34c8e9206f03591460e44629"
WEIGHTS_SHA256 = "e94c089f8eb985a87307dca3a7702385fcaccd14d95743811f8788f7da24448d"
PACKED_WEIGHTS_SHA256 = "ab55ebd0d7d63e3c2b6731489a9f8c2e03bb18eb67d8bc5b39325d34d100199a"
TOKENS_SHA256 = "102fa82b3f8932b37a1ec0d9262e555d23d17852685fe5fb33680dbee19dd694"
RAW_SHA256 = "159b85351e5f76e60cbe32e04c677847a9ecba3adc79addab6f4c6c7aa3744bc"


def check_file(path, size, expected_hash):
    if not path.is_file():
        raise ValueError(f"Missing file: {path}")
    if path.stat().st_size != size:
        raise ValueError(f"Wrong size: {path}")
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for chunk in iter(lambda: source.read(8 * 1024 * 1024), b""):
            digest.update(chunk)
    if digest.hexdigest() != expected_hash:
        raise ValueError(f"Wrong SHA-256: {path}")


def check_runtime():
    import numpy
    import torch

    expected = (
        ("Python", platform.python_version(), "3.12.3"),
        ("NumPy", numpy.__version__, "2.4.6"),
        ("PyTorch", torch.__version__, "2.12.0+cu130"),
        ("TensorBoard", importlib.metadata.version("tensorboard"), "2.20.0"),
        ("CUDA", torch.version.cuda, "13.0"),
        ("cuDNN", torch.backends.cudnn.version(), 92000),
    )
    errors = [f"{name}: found {actual!r}, expected {wanted!r}"
              for name, actual, wanted in expected if actual != wanted]
    if not torch.cuda.is_available():
        errors.append("CUDA is unavailable")
    elif torch.cuda.device_count() != 2:
        errors.append(f"Found {torch.cuda.device_count()} visible GPUs; expected 2")
    elif any("B200" not in torch.cuda.get_device_name(i) for i in range(2)):
        errors.append("Both visible GPUs must be NVIDIA B200s")
    if platform.machine() not in ("x86_64", "AMD64"):
        errors.append("x86-64 is required")
    if errors:
        raise RuntimeError("Unsupported deterministic runtime:\n  " + "\n  ".join(errors))


def codec_command(payload, state):
    return [
        sys.executable, "-m", "torch.distributed.run", "--standalone",
        "--nnodes=1", "--nproc_per_node=2", str(ROOT / "nn.py"),
        "--decompress", "--input", str(payload),
        "--output", str(state / "enwik9.pp"),
        "--checkpoint_dir", str(state / "checkpoint"),
        "--run_dir", str(state / "run"),
        "--initial_prior", str(state / "weights.bin"),
    ]


def decode(payload, state):
    checkpoint = state / "checkpoint"
    stop_file = checkpoint / "STOP_REQUESTED"
    stop_file.unlink(missing_ok=True)
    if (checkpoint / "DONE").exists():
        return 0

    def stop(signum, frame):
        print("Stopping at the next checkpoint; repeat this command to resume.",
              file=sys.stderr)
        stop_file.touch()

    handlers = {sig: signal.signal(sig, stop)
                for sig in (signal.SIGUSR1, signal.SIGTERM, signal.SIGINT)}
    try:
        # Keep terminal signals in the launcher so the codec can checkpoint.
        with subprocess.Popen(codec_command(payload, state), start_new_session=True) as child:
            return child.wait()
    finally:
        for sig, handler in handlers.items():
            signal.signal(sig, handler)


def main():
    parser = argparse.ArgumentParser(description="Decode and verify tufazip v2 enwik9.")
    parser.add_argument("--version", action="version", version="tufazip v2")
    parser.add_argument("payload", type=Path, help="enwik9-v2.bin")
    parser.add_argument("output", type=Path, help="decoded enwik9")
    parser.add_argument("state", nargs="?", type=Path, default=Path("tufazip-v2-state"),
                        help="resumable state directory (default: ./tufazip-v2-state)")
    args = parser.parse_args()
    payload, output, state = (p.expanduser().resolve()
                              for p in (args.payload, args.output, args.state))
    check_file(payload, 100958324, PAYLOAD_SHA256)
    check_file(ROOT / "enwik9.voc", 34421, VOCAB_SHA256)
    check_file(ROOT / "weights.tz", 4147476, PACKED_WEIGHTS_SHA256)
    os.environ.update(DETERMINISTIC_ENV)
    check_runtime()
    (state / "checkpoint").mkdir(parents=True, exist_ok=True)
    (state / "run").mkdir(parents=True, exist_ok=True)
    output.parent.mkdir(parents=True, exist_ok=True)
    # Rebuild the exact transmitted prior (lossless; see wunpack.py).
    sys.path.insert(0, str(ROOT))
    import wunpack
    wunpack.unpack(ROOT / "weights.tz", state / "weights.bin")
    check_file(state / "weights.bin", 4334741, WEIGHTS_SHA256)
    result = decode(payload, state)
    if result:
        return result if result > 0 else 1

    check_file(state / "enwik9.pp", 570405660, TOKENS_SHA256)
    detok = state / "detok"
    subprocess.run(["gcc", "-O2", str(ROOT / "detok.c"), "-o", str(detok)],
                   check=True)
    subprocess.run([str(detok), str(ROOT / "enwik9.voc"),
                    str(state / "enwik9.pp"), str(output)], check=True)
    check_file(output, 1000000000, RAW_SHA256)
    print(f"Decoded and verified: {output}")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as error:
        print(f"tufazip: {error}", file=sys.stderr)
        sys.exit(1)
